---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCover from "../../components/ProjectCover.astro";

const projects = (await getCollection("projects")).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured),
);
---

<BaseLayout title="Projects" description="A collection of projects.">
  <section class="py-8">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box">
          <h1 class="text-3xl font-bold">Projects</h1>
          <p class="mt-2 text-charcoal-blue-300">A collection of projects I have built.</p>

      {
        projects.length === 0 ? (
          <p class="mt-8 rounded-md border border-dashed border-charcoal-blue-700 p-4 text-sm text-charcoal-blue-400">
            No projects yet. Add Markdown files to
            <code class="mx-1 rounded bg-charcoal-blue-900 px-1 py-0.5">src/content/projects/</code>.
          </p>
        ) : (
          <ul class="mt-8 grid gap-6 sm:grid-cols-2">
            {projects.map((project) => (
              <li class="flex">
                <a
                  href={`/projects/${project.id}`}
                  class="group flex flex-1 flex-col rounded-xl border border-charcoal-blue-700 bg-charcoal-blue-950 p-5 transition-colors hover:border-strong-cyan-500"
                >
                  <ProjectCover
                    cover={project.data.cover}
                    title={project.data.title}
                    class="mb-4 aspect-[2/1] w-full rounded-md border border-charcoal-blue-800"
                  />
                  <div class="flex items-start justify-between gap-3">
                    <span class="font-pixel text-xs font-bold uppercase tracking-wide text-olive-leaf-400">
                      {project.data.type}
                    </span>
                    {project.data.featured && (
                      <span class="rounded-md border border-tea-green-600 bg-tea-green-600/10 px-2 py-0.5 font-pixel text-xs font-bold uppercase text-tea-green-400">
                        Featured
                      </span>
                    )}
                  </div>
                  <h2 class="mt-2 text-lg font-semibold text-charcoal-blue-50 transition-colors group-hover:text-strong-cyan-400">
                    {project.data.title}
                  </h2>
                  <p class="mt-1 flex-1 text-sm leading-relaxed text-charcoal-blue-300">
                    {project.data.description}
                  </p>
                  <div class="mt-3 flex items-center justify-between gap-3">
                    <span class="font-pixel text-xs font-bold uppercase tracking-wide text-olive-leaf-400">{project.data.status}</span>
                    {project.data.technologies.length > 0 && (
                      <ul class="flex flex-wrap gap-1.5">
                        {project.data.technologies.slice(0, 3).map((tech) => (
                          <li class="rounded-md border border-charcoal-blue-700 px-2 py-0.5 font-pixel text-xs font-bold text-olive-leaf-300">
                            {tech}
                          </li>
                        ))}
                        {project.data.technologies.length > 3 && (
                          <li class="text-xs text-charcoal-blue-500">
                            +{project.data.technologies.length - 3}
                          </li>
                        )}
                      </ul>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
