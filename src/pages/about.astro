---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
---

<BaseLayout title="About" description="More about me and the work I do.">
  <section class="py-8">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box">
          <h1 class="text-3xl font-bold">About</h1>

      <div class="mt-6 space-y-4 leading-relaxed text-charcoal-blue-300">
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
        {site.aboutExtended.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <h2 class="mt-10 font-pixel text-xl font-bold uppercase tracking-wide text-tea-green-400">Interests</h2>
      {site.interests.length > 0 ? (
        <ul class="mt-3 flex flex-wrap gap-2">
          {site.interests.map((interest) => (
            <li class="rounded-md border border-charcoal-blue-700 bg-charcoal-blue-950 px-3 py-1 font-mono text-sm text-charcoal-blue-200">
              {interest}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm text-charcoal-blue-400">
          Add your interests and focus areas in
          <code class="mx-1 rounded bg-charcoal-blue-900 px-1 py-0.5">src/site.ts</code>
          — kept empty until real information is provided.
        </p>
      )}

      <h2 class="mt-10 font-pixel text-xl font-bold uppercase tracking-wide text-tea-green-400">Get in touch</h2>
      {
        site.email ? (
          <a
            href={`mailto:${site.email}`}
            class="mt-3 inline-block font-medium text-strong-cyan-400 underline transition-colors hover:text-strong-cyan-300"
          >
            {site.email}
          </a>
        ) : (
          <p class="mt-3 text-sm text-charcoal-blue-400">
            Add your contact email in
            <code class="mx-1 rounded bg-charcoal-blue-900 px-1 py-0.5">src/site.ts</code>
            to show it here.
          </p>
        )
      }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
