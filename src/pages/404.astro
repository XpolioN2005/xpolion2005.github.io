---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <section>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box text-center">
          <p class="font-pixel text-sm font-bold uppercase tracking-widest text-tea-green-400">404</p>
          <h1 class="mt-2 text-3xl font-bold">Page not found</h1>
          <p class="mt-3 text-charcoal-blue-300">
            The page you were looking for does not exist or has moved.
          </p>
          <a
            href="/"
            class="mt-8 inline-flex items-center gap-2 border-2 border-charcoal-blue-950 bg-tea-green-600 px-5 py-2 font-pixel text-sm font-bold uppercase tracking-wide text-charcoal-blue-950 transition-colors hover:bg-tea-green-500"
          >
            Back to homepage
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
