---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import HomeTabs from "../components/HomeTabs.astro";
import ContactForm from "../components/ContactForm.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../site";
---

<BaseLayout
    title="Portfolio"
    description="XpolioN portfolio — projects, work experience and devlogs by Darsan Ghosh (XpolioN), game developer and software developer."
  >
  <!-- 1. Hero -->
  <section class="pt-8">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box">
          <!-- Mobile: profile block moves here from the sidebar -->
          <Profile context="hero" heading class="lg:hidden" />
          <h1 class="hidden text-4xl font-bold lg:block">{site.name}</h1>
          <p class="mt-3 max-w-xl text-lg leading-relaxed text-charcoal-blue-300">
            {site.tagline}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="#work"
              class="inline-flex items-center gap-2 border-2 border-charcoal-blue-950 bg-tea-green-600 px-5 py-2 font-pixel text-sm font-bold uppercase tracking-wide text-charcoal-blue-950 transition-colors hover:bg-tea-green-500"
            >
              View my work
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 border-2 border-charcoal-blue-700 bg-charcoal-blue-900 px-5 py-2 font-pixel text-sm font-bold uppercase tracking-wide text-charcoal-blue-100 transition-colors hover:border-strong-cyan-400 hover:text-strong-cyan-400"
            >
              Get in touch
            </a>
            <a
              href={site.resumeUrl || "#"}
              class="inline-flex items-center gap-2 border-2 border-charcoal-blue-700 bg-charcoal-blue-900 px-5 py-2 font-pixel text-sm font-bold uppercase tracking-wide text-charcoal-blue-100 transition-colors hover:border-olive-leaf-500 hover:text-olive-leaf-300 lg:hidden"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download resume
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. About -->
  <section class="py-6">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box">
          <div class="mb-5 flex justify-end">
            <h2 class="section-label">About</h2>
          </div>
          <div class="space-y-3 leading-relaxed text-charcoal-blue-300">
            {site.about.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a
            href="/about"
            class="mt-5 inline-block font-pixel text-sm font-bold uppercase tracking-wide text-strong-cyan-400 underline transition-colors hover:text-strong-cyan-300"
          >
            More about me →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Work Experience / Projects / Skills -->
  <HomeTabs />

  <!-- 4. Contact -->
  <section id="contact" class="scroll-mt-20 pb-8 pt-6">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="panel">
        <div class="panel-box">
          <div class="mb-5 flex justify-end">
            <h2 class="section-label">Contact</h2>
          </div>
          <div class="grid gap-10 md:grid-cols-2">
            <div>
              <h3 class="font-pixel text-sm font-bold uppercase tracking-wider text-tea-green-400">
                Contact information
              </h3>
              <SocialLinks class="-ml-2 mt-4" />
            </div>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
