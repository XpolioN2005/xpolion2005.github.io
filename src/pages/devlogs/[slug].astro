---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { slugifyTag } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <a
      href="/devlogs"
      class="font-pixel text-sm font-bold uppercase tracking-wide text-strong-cyan-400 underline transition-colors hover:text-strong-cyan-300"
    >
      ← All posts
    </a>

    <div class="panel mt-4">
      <div class="panel-box">
    <header class="border-b border-charcoal-blue-700 pb-6">
      <time
        datetime={post.data.pubDate.toISOString().slice(0, 10)}
        class="font-mono text-sm font-bold uppercase tracking-wide text-olive-leaf-400"
      >
        {formatDate(post.data.pubDate)}
      </time>
      <h1 class="mt-2 text-3xl font-bold leading-tight">{post.data.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-charcoal-blue-300">
        {post.data.description}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <a
                  href={`/devlogs/tags/${slugifyTag(tag)}`}
                  class="rounded-md border border-charcoal-blue-700 px-2.5 py-0.5 font-pixel text-xs font-bold text-olive-leaf-300 transition-colors hover:border-olive-leaf-400 hover:text-olive-leaf-200"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.cover && (
        <img
          src={post.data.cover.src}
          alt=""
          width={post.data.cover.width}
          height={post.data.cover.height}
          class="mt-8 w-full rounded-xl border border-charcoal-blue-700"
        />
      )
    }

    <div
      class="prose prose-invert mt-8 max-w-none prose-a:text-strong-cyan-400 prose-blockquote:border-strong-cyan-600 prose-code:bg-charcoal-blue-950 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-h2:mt-10 prose-h2:text-xl prose-h3:text-lg"
    >
      <Content />
    </div>
      </div>
    </div>
  </article>
</BaseLayout>
