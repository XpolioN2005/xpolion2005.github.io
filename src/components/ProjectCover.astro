---
/**
 * Project cover image with an automatic fallback tile.
 *
 * Renders the real cover whenever one is provided (remote/public URL string
 * or optimized local image metadata). Only when NO cover is set does it show
 * the "Coming soon" placeholder with an inline no-picture icon.
 *
 * Source of placeholder icon: Flaticon "no picture taking" #9841566
 * (https://www.flaticon.com/free-icon/no-picture-taking_9841566)
 */
interface Props {
  cover?: string | ImageMetadata;
  title: string;
  /** Container classes — size/shape are controlled by the caller. */
  class?: string;
  /** Hide the "Coming soon" label (for small thumbnails). */
  compact?: boolean;
}

const { cover, title, class: className = "", compact = false } = Astro.props;
---

{
  cover ? (
    <img
      src={typeof cover === "string" ? cover : cover.src}
      alt={title}
      width={typeof cover === "string" ? undefined : cover.width}
      height={typeof cover === "string" ? undefined : cover.height}
      loading="lazy"
      class={className}
    />
  ) : (
    <div
      role="img"
      aria-label={`${title} — cover coming soon`}
      class:list={[
        "flex flex-col items-center justify-center gap-2 bg-charcoal-blue-950",
        className,
      ]}
    >
      <!-- Placeholder icon — Flaticon "no picture taking" #9841566 -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 256 256"
        aria-hidden="true"
        class="h-10 w-10 opacity-80 sm:h-12 sm:w-12"
      >
        <g transform="translate(1.4065934065934016 1.4065934065934016) scale(2.81 2.81)">
          <path
            d="M 75.615 18.569 H 56.279 H 26.36 H 7.024 C 3.697 18.569 1 21.266 1 24.593 v 22.01 v 24.466 c 0 3.327 2.697 6.024 6.024 6.024 h 68.591 c 3.327 0 6.024 -2.697 6.024 -6.024 V 46.603 v -22.01 C 81.639 21.266 78.942 18.569 75.615 18.569 z"
            fill="rgb(193,229,244)"
            stroke-linecap="round"></path>
          <path
            d="M 1 38.824 v 32.245 c 0 3.327 2.697 6.024 6.024 6.024 h 68.591 c 3.327 0 6.024 -2.697 6.024 -6.024 v -1.327 L 54.64 49.852 c -2.257 -1.663 -5.318 -1.719 -7.635 -0.14 l -14.302 9.747 c -2.46 1.676 -5.737 1.5 -8.002 -0.431 L 1 38.824 z"
            fill="rgb(150,234,156)"
            stroke-linecap="round"></path>
          <path
            d="M 75.615 78.093 H 7.024 C 3.151 78.093 0 74.941 0 71.068 V 24.593 c 0 -3.873 3.151 -7.024 7.024 -7.024 h 49.255 c 0.553 0 1 0.448 1 1 s -0.447 1 -1 1 H 7.024 C 4.254 19.569 2 21.823 2 24.593 v 46.475 c 0 2.771 2.254 5.024 5.024 5.024 h 68.591 c 2.771 0 5.024 -2.254 5.024 -5.024 V 46.604 c 0 -0.553 0.447 -1 1 -1 s 1 0.447 1 1 v 24.465 C 82.64 74.941 79.488 78.093 75.615 78.093 z"
            fill="rgb(0,0,0)"
            stroke-linecap="round"></path>
          <circle cx="28.789" cy="36.739" r="6.039" fill="rgb(252,236,141)"></circle>
          <path
            d="M 28.786 43.774 c -3.881 0 -7.039 -3.158 -7.039 -7.039 s 3.158 -7.039 7.039 -7.039 c 3.881 0 7.039 3.158 7.039 7.039 S 32.667 43.774 28.786 43.774 z M 28.786 31.697 c -2.778 0 -5.039 2.26 -5.039 5.039 s 2.26 5.039 5.039 5.039 s 5.039 -2.26 5.039 -5.039 S 31.564 31.697 28.786 31.697 z"
            fill="rgb(0,0,0)"
            stroke-linecap="round"></path>
          <path
            d="M 81.639 70.741 c -0.206 0 -0.413 -0.063 -0.592 -0.195 l -27 -19.89 c -1.911 -1.408 -4.516 -1.456 -6.479 -0.119 l -14.301 9.747 c -2.825 1.924 -6.613 1.722 -9.214 -0.497 L 0.351 39.585 c -0.42 -0.358 -0.47 -0.99 -0.112 -1.41 c 0.358 -0.42 0.989 -0.47 1.41 -0.112 L 25.35 58.266 c 1.917 1.633 4.708 1.785 6.79 0.366 l 14.301 -9.747 c 2.666 -1.815 6.199 -1.75 8.791 0.162 l 27 19.89 c 0.445 0.327 0.54 0.953 0.212 1.397 C 82.249 70.601 81.946 70.741 81.639 70.741 z"
            fill="rgb(0,0,0)"
            stroke-linecap="round"></path>
          <circle cx="76.039" cy="25.869" r="12.959" fill="rgb(226,147,147)"></circle>
          <path
            d="M 76.041 39.824 c -3.729 0 -7.233 -1.452 -9.87 -4.088 l 0 0 c -5.442 -5.442 -5.442 -14.298 0 -19.741 c 2.637 -2.636 6.142 -4.088 9.87 -4.088 s 7.233 1.452 9.87 4.088 C 88.548 18.632 90 22.137 90 25.865 c 0 3.729 -1.452 7.234 -4.089 9.871 C 83.274 38.372 79.77 39.824 76.041 39.824 z M 67.585 34.322 c 2.259 2.259 5.262 3.502 8.456 3.502 s 6.197 -1.244 8.456 -3.502 S 88 29.06 88 25.865 c 0 -3.194 -1.244 -6.197 -3.503 -8.456 s -5.262 -3.502 -8.456 -3.502 s -6.197 1.244 -8.456 3.502 C 62.923 22.072 62.923 29.659 67.585 34.322 L 67.585 34.322 z"
            fill="rgb(0,0,0)"
            stroke-linecap="round"></path>
          <path
            d="M 85.204 36.029 c -0.256 0 -0.512 -0.098 -0.707 -0.293 L 66.171 17.409 c -0.391 -0.391 -0.391 -1.023 0 -1.414 s 1.023 -0.391 1.414 0 l 18.326 18.327 c 0.391 0.391 0.391 1.023 0 1.414 C 85.716 35.931 85.46 36.029 85.204 36.029 z"
            fill="rgb(0,0,0)"
            stroke-linecap="round"></path>
        </g>
      </svg>
      {!compact && (
        <span class="font-pixel text-[10px] font-bold uppercase tracking-widest text-charcoal-blue-400 sm:text-xs">
          Coming soon
        </span>
      )}
    </div>
  )
}
