---
/**
 * Desktop-only full-height sidebar: profile section on top,
 * secondary navigation below. Solid background against the
 * striped main area.
 */
import Profile from "./Profile.astro";
import SiteNav from "./SiteNav.astro";
---

<aside
  class="fixed inset-y-0 left-0 z-30 hidden w-72 flex-col overflow-y-auto border-r border-charcoal-blue-800 bg-charcoal-blue-950 lg:flex"
>
  <div class="border-b border-charcoal-blue-800 p-6">
    <Profile context="sidebar" />
  </div>
  <div class="flex-1 p-6">
    <SiteNav context="sidebar" />
  </div>
</aside>
